# ============================================
# CyberVault Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Application
# ============================================
VITE_APP_NAME=CyberVault
VITE_APP_URL=http://localhost:3000
VITE_APP_ENV=development

# ============================================
# Supabase (Database & Auth)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase (for migrations and admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# AI Provider (Optional)
# ============================================
# Supported: mock, openai, anthropic
VITE_AI_PROVIDER=mock

# OpenAI (if using OpenAI provider)
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_OPENAI_MODEL=gpt-4

# Anthropic (if using Anthropic provider)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
VITE_ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# Email Service (Optional)
# ============================================
# For newsletter and notifications
VITE_EMAIL_PROVIDER=mock

# SendGrid
VITE_SENDGRID_API_KEY=your-sendgrid-api-key
VITE_SENDGRID_FROM_EMAIL=noreply@cybervault.dev

# ============================================
# Storage (Optional)
# ============================================
# For file uploads (images, documents)
VITE_STORAGE_PROVIDER=local

# AWS S3
VITE_AWS_ACCESS_KEY_ID=your-aws-access-key
VITE_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
VITE_AWS_REGION=us-east-1
VITE_AWS_S3_BUCKET=cybervault-uploads

# ============================================
# Security
# ============================================
# Trusted IPs for admin access (comma-separated)
VITE_TRUSTED_IPS=127.0.0.1,::1

# JWT Secret (for additional security)
VITE_JWT_SECRET=your-jwt-secret-min-32-chars

# Encryption key for sensitive data
VITE_ENCRYPTION_KEY=your-encryption-key-32-chars

# ============================================
# Rate Limiting
# ============================================
# Redis for distributed rate limiting (optional)
VITE_REDIS_URL=redis://localhost:6379

# ============================================
# Monitoring & Analytics (Optional)
# ============================================
# Sentry for error tracking
VITE_SENTRY_DSN=your-sentry-dsn

# Analytics
VITE_ANALYTICS_ID=your-analytics-id

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_AI=true
VITE_ENABLE_NEWSLETTER=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_COMMUNITY=true
VITE_ENABLE_JOBS=true
VITE_ENABLE_EVENTS=true

# ============================================
# Development
# ============================================
# Enable debug logging
VITE_DEBUG=false

# Mock data seeding (development only)
VITE_SEED_DATA=true
